# ══════════════════════════════════════════
#  Agent System - Konfiguracja
#  Skopiuj jako .env i uzupełnij wartości
# ══════════════════════════════════════════

# ── API Keys ──────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...twój-klucz...
GEMINI_API_KEY=AIzaSy...twój-klucz...

# Brave Search API — opcjonalny, ale zalecany
# Darmowy tier: 2000 zapytań/mies | bez klucza → fallback DuckDuckGo (słabsze wyniki)
# Rejestracja: https://api.search.brave.com
BRAVE_API_KEY=

# ── MongoDB ───────────────────────────────
MONGO_URL=mongodb://mongo:27017

# ── Ollama ────────────────────────────────
# W Dockerze: http://ollama:11434
# Lokalnie:   http://localhost:11434
OLLAMA_URL=http://ollama:11434

# ── Opcje ─────────────────────────────────
STREAM=true
DEFAULT_MODEL=claude

# ── Serwery ───────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
WEB_PORT=3000

# ── Security (#1) ────────────────────────
# Set to require Bearer token on all API endpoints. Leave empty to disable.
API_KEY=

# Allowed CORS + WebSocket origins (#5)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3003,http://localhost:3004

# ── Rate limiting ─────────────────────────
RATE_LIMIT_RPM=60
SESSION_RATE_LIMIT_RPM=20

# ── Session management (#8) ──────────────
MAX_SESSIONS=200
MAX_REQUEST_COST_USD=0

# ── Context / summarization (#10) ────────
SUMMARIZE_THRESHOLD=16

# ── File injection (#3) ──────────────────
# Colon-separated dirs allowed for @file. Defaults to /tmp:/var/tmp
ALLOWED_FILE_ROOTS=/tmp:/var/tmp

# ── Logging (#13) ────────────────────────
# json = structured JSON logs (production); text = human-readable (dev)
LOG_FORMAT=text
LOG_LEVEL=INFO

# ── OpenTelemetry (optional) ──────────────
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
