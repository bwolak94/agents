FROM python:3.12-slim

WORKDIR /app

# #28 — curl for HEALTHCHECK + gunicorn for production ASGI (#30)
RUN apt-get update && apt-get install -y \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Python dependencies
COPY requirements.txt .
# #30 — install gunicorn for production ASGI serving
RUN pip install --no-cache-dir -r requirements.txt gunicorn uvicorn[standard]

# Application code
COPY . .

EXPOSE 8000

# #28 — Docker HEALTHCHECK (avoids relying solely on docker-compose healthcheck)
HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=3 \
    CMD curl -f http://localhost:8000/ || exit 1

# #30 — Production: gunicorn with uvicorn workers.
# Override CMD to use uvicorn directly for development (--reload).
CMD ["gunicorn", "api.server:app", \
     "--worker-class", "uvicorn.workers.UvicornWorker", \
     "--workers", "2", \
     "--bind", "0.0.0.0:8000", \
     "--timeout", "120", \
     "--access-logfile", "-", \
     "--error-logfile", "-"]
